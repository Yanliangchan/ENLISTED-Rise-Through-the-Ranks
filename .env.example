# Copy to .env for local development. Railway sets these as service
# environment variables instead — do not commit a real .env.

# Local Postgres connection string. On Railway, attach a Postgres plugin and
# reference it on the web service as ${{Postgres.DATABASE_URL}} instead of
# setting a literal value here.
DATABASE_URL=postgresql://enlisted:enlisted@localhost:5432/enlisted

# Signing secret for login tokens. Generate a real one for any deployed
# environment: `openssl rand -hex 32`. Never reuse the example value.
JWT_SECRET=dev-only-secret-change-me

# The server serves both the API and the built frontend on this port. Railway
# injects its own PORT at runtime and that value always wins.
PORT=8080
